{
  "name": "@workspace/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API for the student management system: cookies, CSRF guard, validation and routes over @workspace/auth and @workspace/domain.",
  "exports": {
    ".": {
      "browser": "./src/browser-blocked.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000"
  },
  "dependencies": {
    "@workspace/auth": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/domain": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
