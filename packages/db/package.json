{
  "name": "@workspace/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Student management system database package (Drizzle ORM schema, migrations and seed for PostgreSQL). Design v1.0.",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "browser": "./src/browser-blocked.ts",
      "default": "./src/client.ts"
    },
    "./schema": "./src/schema/index.ts",
    "./money": "./src/money.ts",
    "./seed": "./src/seed.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0"
  }
}
