{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "test": { "cache": false },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false, "passThroughEnv": ["DATABASE_URL_DIRECT"] },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
